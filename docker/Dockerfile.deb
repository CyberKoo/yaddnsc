# yaddnsc DEB package builder for Debian and Ubuntu
#
# Usage:
#   docker build -f docker/Dockerfile.deb \
#       --build-arg BASE_IMAGE=debian:13 -o deb-out .
#   docker build -f docker/Dockerfile.deb \
#       --build-arg BASE_IMAGE=ubuntu:24.04 -o deb-out .

ARG BASE_IMAGE=ubuntu:24.04

FROM ${BASE_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG YADDNSC_USE_SYSTEM_SPDLOG=ON
ARG YADDNSC_DEFAULT_DNS_SERVER=1.1.1.1
ARG YADDNSC_DEFAULT_DNS_PORT=53
ARG YADDNSC_PACKAGE_VERSION=""
ARG BUILD_JOBS=2
ARG CMAKE_EXTRA_ARGS=""

RUN . /etc/os-release && \
    case "${ID}" in \
        ubuntu|debian) ;; \
        *) echo "Unsupported DEB base image: ${ID}; use ubuntu or debian" >&2; exit 1 ;; \
    esac

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        pkg-config \
        libssl-dev \
        libspdlog-dev \
        libfmt-dev \
        libsystemd-dev \
        libxml2-dev \
        ca-certificates \
        file \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 ships GCC 13 by default; yaddnsc requires GCC 14+.
RUN . /etc/os-release && \
    if [ "${ID}" = "ubuntu" ] && [ "${VERSION_ID}" = "24.04" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            gcc-14 g++-14 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /src
COPY . .

RUN . /etc/os-release && \
    if [ "${ID}" = "ubuntu" ] && [ "${VERSION_ID}" = "24.04" ]; then \
        export CC=gcc-14 CXX=g++-14; \
    fi; \
    cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DYADDNSC_USE_SYSTEM_SPDLOG=${YADDNSC_USE_SYSTEM_SPDLOG} \
        -DYADDNSC_PACKAGE_VERSION=${YADDNSC_PACKAGE_VERSION} \
        -DYADDNSC_DEFAULT_DNS_SERVER=${YADDNSC_DEFAULT_DNS_SERVER} \
        -DYADDNSC_DEFAULT_DNS_PORT=${YADDNSC_DEFAULT_DNS_PORT} \
        -DYADDNSC_ENABLE_DEB=ON \
        ${CMAKE_EXTRA_ARGS}

RUN cmake --build build -j "${BUILD_JOBS}"
RUN mkdir -p /deb-out /deb-upgrade/v1 /deb-upgrade/v2
RUN cpack --config build/CPackConfig.cmake -G DEB && \
    mv yaddnsc*.deb /deb-out/
RUN base_version="$(sed -n 's/^project(yaddnsc VERSION \([0-9][0-9.]*\)).*/\1/p' CMakeLists.txt)" && \
    cmake -B build -DYADDNSC_PACKAGE_VERSION="${base_version}~upgrade.1" && \
    cpack --config build/CPackConfig.cmake -G DEB -B /deb-upgrade/v1
RUN base_version="$(sed -n 's/^project(yaddnsc VERSION \([0-9][0-9.]*\)).*/\1/p' CMakeLists.txt)" && \
    cmake -B build -DYADDNSC_PACKAGE_VERSION="${base_version}~upgrade.2" && \
    cpack --config build/CPackConfig.cmake -G DEB -B /deb-upgrade/v2

FROM scratch AS export-untested
COPY --from=builder /deb-out/*.deb /

FROM ${BASE_IMAGE} AS verify

ARG YADDNSC_PACKAGE_VERSION=""
ENV EXPECTED_PACKAGE_VERSION=${YADDNSC_PACKAGE_VERSION}

COPY --from=builder /deb-out /packages
COPY --from=builder /deb-upgrade /deb-upgrade
COPY --chmod=0755 test/packaging/verify-deb.sh /usr/local/bin/verify-deb
RUN /usr/local/bin/verify-deb

FROM scratch AS export
COPY --from=verify /packages/*.deb /
