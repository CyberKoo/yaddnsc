# clangd does not recognize the GCC-specific C++ module scanning flags that
# CMake injects into compile_commands.json for C++20+ targets (the project
# does not use C++ modules). Strip them before the compile command is parsed.
CompileFlags:
  Remove:
    - -fmodules-ts
    - -fmodule-mapper=*
    - -fdeps-format=*
    - -fdeps-file=*
    - -fdeps-target=*

# Flag includes that are unused, or that are only satisfied transitively
# (the classic "builds with libstdc++, fails with libc++" bug).
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
