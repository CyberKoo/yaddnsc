pkgname=yaddnsc
maintainer="CyberKoo <2918558+CyberKoo@users.noreply.github.com>"
builddir="/src"
pkgver=$(sed -n 's/^project(yaddnsc VERSION \([0-9][0-9.]*\)).*/\1/p' "$builddir/CMakeLists.txt")
pkgrel=0
pkgdesc="Yet Another Dynamic DNS Client"
url="https://github.com/CyberKoo/yaddnsc"
arch="x86_64 aarch64"
license="MIT"
depends="ca-certificates"
depends_dev="openssl-dev libxml2-dev"
makedepends="build-base cmake git openssl-dev libxml2-dev pkgconf samurai"
install="$pkgname.pre-install $pkgname.pre-deinstall"
subpackages="$pkgname-dev $pkgname-openrc"
source=""

build() {
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DYADDNSC_BUILD_TESTS=OFF \
        -DYADDNSC_DEFAULT_DNS_SERVER="${YADDNSC_DEFAULT_DNS_SERVER:-1.1.1.1}" \
        -DYADDNSC_DEFAULT_DNS_PORT="${YADDNSC_DEFAULT_DNS_PORT:-53}" \
        ${YADDNSC_CMAKE_EXTRA_ARGS}
    cmake --build build --parallel "${ABUILD_JOBS:-2}"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgdir/usr/share/fish/completions/yaddnsc.fish" \
        "$pkgdir/usr/share/fish/vendor_completions.d/yaddnsc.fish"
    rm -rf "$pkgdir/usr/share/fish/completions"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/yaddnsc/LICENSE"
}

dev() {
    amove usr/share/yaddnsc/vendor usr/share/yaddnsc/examples
    default_dev
    depends="$depends_dev"
}

openrc() {
    depends="$pkgname=$pkgver-r$pkgrel openrc"
    install -Dm755 "$builddir/template/apk/yaddnsc.initd" \
        "$subpkgdir/etc/init.d/yaddnsc"
    install -Dm644 "$builddir/template/apk/yaddnsc.confd" \
        "$subpkgdir/etc/conf.d/yaddnsc"
}
