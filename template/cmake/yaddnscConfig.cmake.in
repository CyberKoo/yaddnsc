@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(yaddnsc_GLAZE_VERSION "@YADDNSC_GLAZE_VERSION@")

set(_yaddnsc_requested_components "${yaddnsc_FIND_COMPONENTS}")
if (NOT _yaddnsc_requested_components)
    set(_yaddnsc_requested_components plugin_sdk)
    set(yaddnsc_FIND_REQUIRED_plugin_sdk TRUE)
endif ()

set(yaddnsc_plugin_abi_FOUND TRUE)
set(yaddnsc_plugin_sdk_FOUND FALSE)
set(yaddnsc_plugin_sdk_crypto_FOUND FALSE)
set(yaddnsc_plugin_sdk_xml_FOUND FALSE)
include("${CMAKE_CURRENT_LIST_DIR}/yaddnscAbiTargets.cmake")

if ("plugin_sdk_xml" IN_LIST _yaddnsc_requested_components AND @YADDNSC_HAS_SDK_XML_COMPONENT@)
    if (yaddnsc_FIND_REQUIRED_plugin_sdk_xml)
        find_dependency(LibXml2)
    else ()
        find_package(LibXml2 QUIET)
    endif ()
    if (LibXml2_FOUND)
        set(yaddnsc_plugin_sdk_xml_FOUND TRUE)
    endif ()
endif ()

if ("plugin_sdk" IN_LIST _yaddnsc_requested_components OR yaddnsc_plugin_sdk_xml_FOUND)
    # Preflight permits a useful SDK-specific diagnostic and optional components.
    find_package(glaze @YADDNSC_GLAZE_VERSION@ EXACT CONFIG QUIET)
    if (glaze_FOUND)
        find_dependency(glaze @YADDNSC_GLAZE_VERSION@ EXACT CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/yaddnscSdkTargets.cmake")
        set(yaddnsc_plugin_sdk_FOUND TRUE)
        if (yaddnsc_plugin_sdk_xml_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/yaddnscXmlTargets.cmake")
        endif ()
    else ()
        set(yaddnsc_plugin_sdk_xml_FOUND FALSE)
        set(yaddnsc_NOT_FOUND_MESSAGE
            "The C++ SDK requires exactly Glaze @YADDNSC_GLAZE_VERSION@. Install the complete yaddnsc-dev package (including bundled Glaze), check CMAKE_PREFIX_PATH/glaze_DIR, and remove stale CMake caches.")
    endif ()
endif ()

if ("plugin_sdk_crypto" IN_LIST _yaddnsc_requested_components)
    if (yaddnsc_FIND_REQUIRED_plugin_sdk_crypto)
        find_dependency(OpenSSL 3.0)
    else ()
        find_package(OpenSSL 3.0 QUIET)
    endif ()
    if (OpenSSL_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/yaddnscCryptoTargets.cmake")
        set(yaddnsc_plugin_sdk_crypto_FOUND TRUE)
    endif ()
endif ()

check_required_components(yaddnsc)
